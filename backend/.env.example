DATABASE_URL=postgresql+asyncpg://agentic:agentic@localhost:5432/agentic_office
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3000
VECTOR_DIMENSION=1536
RAG_ENABLED=true
# Gemini embedding model for long-term memory (must match VECTOR_DIMENSION via output_dimensionality)
EMBEDDING_MODEL=models/gemini-embedding-001
E2B_API_KEY=
# Google AI Studio / Gemini API — Researcher, Writer, QA, Developer, escalation
GOOGLE_API_KEY=
# e.g. gemini-2.5-pro (Gemini Pro family); override when Google releases newer ids
GEMINI_MODEL=gemini-2.5-pro
# Relative to backend/ unless absolute
STORAGE_ROOT=storage
